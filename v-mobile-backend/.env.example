APP_NAME=V Messenger API
API_V1_PREFIX=/api/v1
DEBUG=true
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/messenger
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/messenger
POSTGRES_DB=messenger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=messenger
MINIO_SECURE=false
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://localhost:8081
BACKEND_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json
FCM_TIMEOUT_SECONDS=5
AI_PROVIDER=groq
AI_TIMEOUT_SECONDS=20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
